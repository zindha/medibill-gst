# Leave VITE_API_URL unset (or empty) so the SPA uses a same-origin relative "/api".
#   - Local dev  : Vite (:5173) proxies /api -> 127.0.0.1:3000  (see vite.config.ts)
#   - Production : Fastify (:3000) serves the SPA and the API on the same origin
#   - Tunneled   : same-origin works through cloudflared/ngrok with no extra config
#
# Only set this if the API lives on a DIFFERENT origin than the SPA, e.g.:
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
